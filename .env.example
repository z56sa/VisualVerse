# Discord Bot Token (from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application / Client ID (from Discord Developer Portal -> General Information)
CLIENT_ID=your_client_id_here

# Giphy API Key (from Giphy Developers Portal -> Create an API Key)
GIPHY_API_KEY=your_giphy_api_key_here

# Optional: Specific Guild ID for instant slash command testing during development
# Leave empty to register globally across all servers:
GUILD_ID=
