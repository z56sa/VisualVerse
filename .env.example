# Discord Bot Configuration
# توكن البوت ومعرف التطبيق من Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# (اختياري) معرف سيرفر التجربة لتحديث الأوامر فورياً
# إذا تركته فارغاً سيتم تسجيل الأوامر عالمياً (Global)
GUILD_ID=

# منفذ تشغيل سيرفر الصحة للخدمات السحابية مثل Render / Railway
PORT=3000
